<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Produtos Mockados</title>
  <style>
    /* Adicione seu estilo aqui, ou use algo como o Bootstrap */
  </style>
</head>
<body>

  <h1>Produtos Mockados</h1>

  <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
    {{#each products}}
      <div style="border: 1px solid #ccc; padding: 1rem; width: 250px;">
        <h2>{{title}}</h2>
        <p><strong>Categoria:</strong> {{category}}</p>
        <p>{{description}}</p>
        <p><strong>Preço:</strong> R$ {{price}}</p>
        <p><strong>Estoque:</strong> {{stock}}</p>
        <button>Comprar</button>
      </div>
    {{/each}}
  </div>

</body>
</html>
